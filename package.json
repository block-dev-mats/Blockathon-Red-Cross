{
  "name": "blockathon-red-cross-prototype",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5175 --strictPort",
    "build": "tsc --noEmit && vite build",
    "test": "node --import tsx --test src/*.test.ts",
    "preview": "vite preview --host 127.0.0.1 --port 5175 --strictPort",
    "contract:build": "forge build",
    "local:init": "npm run contract:build && node --import tsx scripts/local.ts init",
    "local:start": "node --import tsx scripts/local.ts start",
    "local:services": "node --import tsx scripts/local.ts services",
    "local:chain": "node --import tsx scripts/local.ts chain",
    "local:api": "node --import tsx scripts/local.ts api",
    "local:reset": "node --import tsx scripts/local.ts reset",
    "demo": "node --import tsx scripts/demo.ts",
    "test:mvp": "npm run contract:build && node --import tsx --test tests/mvp.test.ts",
    "test:browser": "node --import tsx --test tests/browser.test.ts",
    "check": "npm test && npm run test:mvp && npm run build"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.6.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "viem": "^2.56.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "playwright": "^1.63.0",
    "tsx": "^4.20.5",
    "typescript": "~5.9.2",
    "vite": "^7.1.5"
  }
}
